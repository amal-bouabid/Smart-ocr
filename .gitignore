# ========================
# Root .gitignore
# ========================

# Dependencies
**/node_modules/
**/build/
**/dist/

# Environment variables
.env
.env.local
.env.production
.env.development

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
*.lcov

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Frontend specific
frontend/.env
frontend/build/

# Backend specific
backend/.env
backend/data/

# Temporary files
*.tmp
*.temp

# Docker
.docker/
.dockerignore

# OS
**/.DS_Store